# Ein natives Programm, das beim Bauen eines Plugins entsteht, wenn man GOOS
# vergisst. Es ist kein Plugin — das Modul heisst plugin.wasm — und gehört
# nicht ins Repository.
plugins/*/bestellung
plugins/*/kontaktformular
plugins/*/jahreszahl
plugins/*/suche
plugins/*/nicht-gefunden

